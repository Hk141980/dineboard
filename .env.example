# ========================================
# DineBoard Environment Variables
# ========================================

# ---- Application ----
NODE_ENV=development
PORT=4000
APP_NAME=DineBoard
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://dineboard_user:dineboard_dev_password@localhost:5432/dineboard

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT Auth ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Razorpay (Platform Account) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Razorpay Route (Commission Splits) ----
RAZORPAY_ACCOUNT_ID=acc_xxxxxxxxxxxx

# ---- Wati (WhatsApp BSP) ----
WATI_API_URL=https://live-server-xxxxxx.wati.io
WATI_API_TOKEN=your_wati_api_token

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-pro

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dineboard-assets

# ---- CloudFront CDN ----
CLOUDFRONT_URL=https://dxxxxxxxxx.cloudfront.net

# ---- Email (Optional - for invoices) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---- Super Admin ----
SUPER_ADMIN_EMAIL=admin@dineboard.in
SUPER_ADMIN_PASSWORD=change-this-password

# ---- Commission Defaults ----
DEFAULT_ORDER_COMMISSION_RATE=5
DEFAULT_BOOKING_COMMISSION_RATE=3
