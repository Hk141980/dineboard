# ===================================================
# DINEBOARD PRODUCTION ENVIRONMENT CONFIGURATION
# Domain: dineboard.in
# Server: AWS EC2 (c7i-flex.large - Ubuntu 24.04)
# ===================================================

NODE_ENV=production
PORT=4000

# PostgreSQL Database (Docker internal connection or AWS RDS)
DATABASE_URL=postgresql://dineboard_user:DineBoard_Prod_SecurePassword2026!@postgres:5432/dineboard?schema=public

# Redis Cache & BullMQ Queue
REDIS_URL=redis://redis:6379

# Authentication & Security (Generate a random 64-char string)
JWT_SECRET=production_jwt_secret_dineboard_2026_x89a71b2k98q
JWT_EXPIRES_IN=7d

# Razorpay Live / Test Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Meta WhatsApp Cloud API Credentials
META_WA_API_URL=https://graph.facebook.com/v18.0
META_WA_VERIFY_TOKEN=dineboard_whatsapp_verify_token_prod
META_WA_SYSTEM_TOKEN=EAAYPB5sMDxgBSEImyXmFy3a...

# Google Gemini AI Integration
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key

# DineBoard Application URLs
APP_URL=https://dineboard.in
API_URL=https://dineboard.in/api

# Super Admin Account
SUPER_ADMIN_EMAIL=info@dineboard.in
SUPER_ADMIN_PASSWORD=ChangeThisPassword2026!

# SMTP Email Service (info@dineboard.in via Zoho/Gmail/Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@dineboard.in
SMTP_PASS=your_email_app_password

# AWS S3 Storage (For logo & menu uploads)
AWS_S3_BUCKET=dineboard-media-prod
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
