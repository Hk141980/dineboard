# ========================================
# DineBoard Environment Variables
# ========================================

# ---- Application ----
NODE_ENV=production
PORT=4000
APP_NAME=DineBoard
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://dineboard_user:dineboard_prod_secure_password_123@postgres:5432/dineboard?schema=public

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- JWT Auth ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Razorpay (Platform Account) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-pro

# ---- Meta WhatsApp Cloud API ----
META_WHATSAPP_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_meta_phone_id
WHATSAPP_VERIFY_TOKEN=dineboard_secure_verify_token
